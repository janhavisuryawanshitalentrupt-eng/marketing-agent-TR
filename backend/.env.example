# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Database ---
# Dev default is SQLite (leave blank to use it). For Postgres:
# DATABASE_URL=postgresql+psycopg://talentrupt:talentrupt@localhost:5432/talentrupt_ai
DATABASE_URL=

# --- LLM provider ---
# none = deterministic fallback (no key). openai = use OpenAI-compatible API.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Image provider ---
IMAGE_PROVIDER=none

# --- Brand logo ---
# Absolute path to the REAL Talentrupt logo PNG. When set, it is used verbatim on every generated
# image/deck/PDF (refreshed automatically when the file changes). Leave blank to use a synthesized
# fallback. Recommended: save the official logo and point here, e.g.
# BRAND_LOGO_PATH=C:\Users\Admin\Downloads\Marketing Agent\storage\brand\tr_logo_official.png
BRAND_LOGO_PATH=

# --- Auth (dev) ---
ADMIN_USERNAME=Admin@talentrupt.com
ADMIN_PASSWORD=Admin123
ADMIN_TOKEN=dev-talentrupt-admin-token

# --- Email / password reset (optional) ---
# Used to email the 'forgot password' reset code. Until SMTP_HOST + SMTP_FROM are set, the reset flow
# still works but the code is written to the server log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Dev-only: when email is NOT configured, return the reset code in the API response so you can test the
# flow. Keep this false in any shared/production environment.
AUTH_RESET_DEV_RETURN_CODE=false

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
