# Copy to backend/.env and fill in. backend/.env is gitignored.
#
# PRODUCTION CHECKLIST (the defaults are DEV — they will NOT do real AI):
#   1. LLM_PROVIDER=openai   AND   IMAGE_PROVIDER=openai   AND   a real OPENAI_API_KEY
#   2. Change ADMIN_PASSWORD / MEMBER_PASSWORD and set strong random ADMIN_TOKEN / MEMBER_TOKEN
#   3. CORS_ORIGINS = your public origin (e.g. https://myra.htuniverse.com)
#   4. Point KNOWLEDGE_* and BRAND_LOGO_PATH at files that exist ON THE SERVER (or leave blank)
#   5. STORAGE_DIR = a persistent path on the server (survives redeploys)

# --- Database ---
# Dev default is SQLite at backend/talentrupt.db (leave blank to use it). For Postgres:
# DATABASE_URL=postgresql+psycopg://talentrupt:talentrupt@localhost:5432/talentrupt_ai
DATABASE_URL=

# --- LLM provider (TEXT) ---
# none = deterministic fallback (no key). openai = real generation. MUST be "openai" in production.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Web-search model for live hiring-signal discovery (Business Dev).
OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview

# --- Image provider (gpt-image-1) ---
# none/compositor = deterministic brand template. openai = gpt-image-1. MUST be "openai" in production.
IMAGE_PROVIDER=none
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1024

# --- Targeting ---
DEFAULT_LOCATION=United States

# --- Contact enrichment (optional; Business Dev real contacts) ---
# none | apollo | hunter. Off by default (contacts stay role-only until a key is set).
ENRICHMENT_PROVIDER=none
ENRICHMENT_API_KEY=
ENRICHMENT_BASE_URL=

# --- Brand knowledge (source library that grounds generation) ---
# These ground posts/images in Talentrupt's real brand. On the SERVER, copy the files there and set
# absolute Linux paths (e.g. /root/talentrupt-agent/assets/...). Leave blank to skip (grounding degrades
# gracefully). First boot with these set + LLM_PROVIDER=openai will run vision ingestion (OpenAI cost).
KNOWLEDGE_ZIP_PATH=
KNOWLEDGE_USE_VISION=true
KNOWLEDGE_MAX_IMAGES=200
# Semicolon-separated extra PDFs (e.g. the sales deck).
KNOWLEDGE_EXTRA_PDFS=

# --- Brand logo ---
# Absolute path to the REAL Talentrupt logo PNG, used verbatim on every generated asset. Blank = a
# synthesized fallback. On the server: BRAND_LOGO_PATH=/root/talentrupt-agent/assets/tr_logo.png
BRAND_LOGO_PATH=

# --- Auth ---
# CHANGE these for production. Tokens are the bearer values used by the browser session — make them
# long random strings (e.g. `openssl rand -hex 24`).
ADMIN_USERNAME=Admin@talentrupt.com
ADMIN_PASSWORD=
ADMIN_TOKEN=
# Non-admin member: this role does NOT see Tasks or Analytics (nav hidden + APIs admin-only).
MEMBER_USERNAME=nishant@talentrupt.com
MEMBER_PASSWORD=
MEMBER_TOKEN=

# --- Email / password reset (optional) ---
# Used to email the 'forgot password' reset code. Until SMTP_HOST + SMTP_FROM are set, the reset flow
# still works but the code is written to the server log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Dev-only: when email is NOT configured, return the reset code in the API response. Keep false in prod.
AUTH_RESET_DEV_RETURN_CODE=false

# --- Storage / CORS ---
# STORAGE_DIR holds generated images/decks/pdfs + uploads. Use a PERSISTENT path on the server.
STORAGE_DIR=
# Comma-separated allowed origins. In production set this to your public origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
